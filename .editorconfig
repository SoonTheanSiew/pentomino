#
# Editor defaults for every file type. CONTRIBUTING.md explains the rules;
# scripts/format.sh checks the C++ and CMake ones.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,hpp,h,cc,sh,cmake,txt}]
max_line_length = 80

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
