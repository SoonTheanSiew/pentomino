#
# Layout rules for all C++ in the repository. CONTRIBUTING.md explains them.
# Naming rules are checked by clang-tidy instead; see .clang-tidy.
---
Language: Cpp
BasedOnStyle: Google
Standard: Latest

ColumnLimit: 80
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
AccessModifierOffset: -2

BreakBeforeBraces: Allman
SpaceBeforeParens: ControlStatements

DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Pointer

AllowShortLambdasOnASingleLine: All
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortEnumsOnASingleLine: false

NamespaceIndentation: All
FixNamespaceComments: true

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
# Order: this project, the C++ standard library, then other libraries.
# In Foo.cpp, Foo.hpp comes first of all.
IncludeCategories:
    - Regex: '^"'
      Priority: 1
    - Regex: '^<[a-z_]+>$'
      Priority: 2
    - Regex: '^<.*>$'
      Priority: 3

MaxEmptyLinesToKeep: 1
...
